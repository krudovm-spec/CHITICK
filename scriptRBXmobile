-- === ОСНОВНОЙ СКРИПТ ДЛЯ ТЕЛЕФОНА ===
function startMobileScript()
    local isAiming = false
    
    -- === БОЛЬШАЯ КНОПКА ДЛЯ АИМБОТА ===
    local aimButton = Instance.new("ImageButton", CoreGui)
    aimButton.Size = UDim2.new(0, 80, 0, 80)
    aimButton.Position = UDim2.new(1, -95, 1, -95)
    aimButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    aimButton.Image = "rbxassetid://6031082811" -- круглая иконка
    aimButton.ScaleType = Enum.ScaleType.Fit
    Instance.new("UICorner", aimButton).CornerRadius = UDim.new(1, 0)
    
    -- Эффект при нажатии
    local pressTween = TweenService:Create(aimButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(255, 50, 50)})
    local releaseTween = TweenService:Create(aimButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(0, 120, 255)})
    
    aimButton.TouchTap:Connect(function()
        isAiming = not isAiming
        if isAiming then
            pressTween:Play()
            -- Индикатор что аимбот включен
            aimButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        else
            releaseTween:Play()
            aimButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        end
    end)
    
    -- Альтернатива: удержание (для тех кому удобнее)
    aimButton.TouchLongPress:Connect(function()
        isAiming = true
        pressTween:Play()
    end)
    
    aimButton.TouchEnd:Connect(function()
        isAiming = false
        releaseTween:Play()
    end)
    
    -- === ПОИСК БЛИЖАЙШЕГО ВРАГА ===
    local function getClosestEnemy()
        local closest = nil
        local minDist = math.huge
        local center = camera.ViewportSize / 2
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("Head") then
                local screenPos, onScreen = camera:WorldToViewportPoint(plr.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = plr
                    end
                end
            end
        end
        return closest
    end
    
    -- === АИМБОТ ===
    RunService.RenderStepped:Connect(function()
        if isAiming then
            local target = getClosestEnemy()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, target.Character.Head.Position), 0.2)
            end
        end
    end)
    
    -- === ИНДИКАТОР АИМБОТА ===
    local indicator = Instance.new("Frame", CoreGui)
    indicator.Size = UDim2.new(0, 60, 0, 60)
    indicator.Position = UDim2.new(0.5, -30, 0.5, -30)
    indicator.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    indicator.BackgroundTransparency = 0.8
    indicator.Visible = false
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)
    
    RunService.RenderStepped:Connect(function()
        indicator.Visible = isAiming
        indicator.BackgroundTransparency = isAiming and 0.5 or 0.8
    end)
    
    -- === ESP: БОЛЬШИЕ ГОЛОВЫ ===
    RunService.RenderStepped:Connect(function()
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                head.Size = Vector3.new(5, 5, 5)
                head.Transparency = 0.3
                head.Material = Enum.Material.Neon
                head.Color = Color3.fromRGB(255, 0, 0)
            end
        end
    end)
    
    -- === ESP: КВАДРАТЫ НАД ГОЛОВОЙ ===
    local function createBox(plr)
        plr.CharacterAdded:Connect(function(char)
            local root = char:WaitForChild("HumanoidRootPart", 10)
            if not root then return end
            
            local gui = Instance.new("BillboardGui", root)
            gui.Name = "BoxEsp"
            gui.AlwaysOnTop = true
            gui.Size = UDim2.new(3, 0, 4, 0)
            gui.Adornee = root
            
            local frame = Instance.new("Frame", gui)
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundTransparency = 1
            frame.BorderColor3 = Color3.new(1, 1, 1)
            frame.BorderSizePixel = 2
        end)
    end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then createBox(plr) end
    end
    Players.PlayerAdded:Connect(createBox)
    
    -- === KILL AURA ===
    local killRange = 20
    RunService.Stepped:Connect(function()
        local char = player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool and char and char:FindFirstChild("HumanoidRootPart") then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local distance = (char.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                    if distance <= killRange then
                        tool:Activate()
                        if tool:FindFirstChild("Handle") then
                            firetouchinterest(plr.Character.HumanoidRootPart, tool.Handle, 0)
                            firetouchinterest(plr.Character.HumanoidRootPart, tool.Handle, 1)
                        end
                    end
                end
            end
        end
    end)
    
    -- === ПИНГ В ПРАВОМ ВЕРХНЕМ УГЛУ ===
    local pingFrame = Instance.new("Frame", CoreGui)
    pingFrame.Size = UDim2.new(0, 100, 0, 30)
    pingFrame.Position = UDim2.new(1, -110, 0, 10)
    pingFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    pingFrame.BackgroundTransparency = 0.5
    Instance.new("UICorner", pingFrame).CornerRadius = UDim.new(0, 8)
    
    local pingText = Instance.new("TextLabel", pingFrame)
    pingText.Size = UDim2.new(1, 0, 1, 0)
    pingText.BackgroundTransparency = 1
    pingText.TextColor3 = Color3.new(1, 1, 1)
    pingText.TextSize = 14
    pingText.Font = Enum.Font.GothamBold
    pingText.Text = "Пинг: --"
    
    RunService.RenderStepped:Connect(function()
        local ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
        pingText.Text = "📶 " .. ping .. " ms"
        if ping < 80 then pingText.TextColor3 = Color3.new(0, 255, 0)
        elseif ping < 150 then pingText.TextColor3 = Color3.new(255, 255, 0)
        else pingText.TextColor3 = Color3.new(255, 0, 0) end
    end)
    
    -- === МАРКЕРЫ СМЕРТИ ===
    Players.PlayerRemoving:Connect(function(plr)
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local marker = Instance.new("Part")
            marker.Shape = Enum.PartType.Ball
            marker.Size = Vector3.new(2.5, 2.5, 2.5)
            marker.Position = plr.Character.HumanoidRootPart.Position
            marker.Anchored = true
            marker.CanCollide = false
            marker.Color = Color3.new(1, 1, 1)
            marker.Material = Enum.Material.Neon
            marker.Transparency = 0.4
            marker.Parent = workspace
            
            local highlight = Instance.new("Highlight", marker)
            highlight.FillColor = Color3.new(1, 1, 1)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            
            game:GetService("Debris"):AddItem(marker, 10)
        end
    end)
    
    -- === УВЕДОМЛЕНИЕ ===
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Чит для телефона",
        Text = "Нажми на синюю кнопку для аимбота | Kill Aura активна",
        Duration = 4
    })
end
