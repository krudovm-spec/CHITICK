--==============================================
-- АКТИВАЦИЯ
--==============================================
local CODE = "FREE_SLAKINKODUPDATE"
local HOURS = 12
local FILE = "HenoTime.json"

local activated = false
local expiry = 0
local remain = 0

-- Загрузка
pcall(function()
    local d = HttpService:JSONDecode(readfile(FILE))
    if d.exp and os.time() < d.exp then
        activated = true
        expiry = d.exp
        remain = d.exp - os.time()
    end
end)

-- Сохранение
local function save()
    pcall(function()
        writefile(FILE, HttpService:JSONEncode({exp = expiry}))
    end)
end

-- Активировать
local function activate()
    expiry = os.time() + HOURS * 3600
    activated = true
    remain = HOURS * 3600
    save()
end

-- Формат времени
local function fmt(s)
    return string.format("%02d:%02d:%02d", s/3600, (s%3600)/60, s%60)
end

