local function setOptimize(state)
    Lighting.GlobalShadows = not state
    Workspace.StreamingMinRadius = state and 32 or 64
    Workspace.StreamingTargetRadius = state and 64 or 256
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then pcall(function() obj:Destroy() end) end
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") then obj.Enabled = false end
        end
        Lighting.Bloom.Enabled = false
        Lighting.Blur.Enabled = false
        Lighting.ColorCorrection.Enabled = false
        Lighting.SunRays.Enabled = false
        Lighting.DepthOfField.Enabled = false
    else
        Lighting.Bloom.Enabled = true
        Lighting.ColorCorrection.Enabled = true
        Workspace.StreamingMinRadius = 64
        Workspace.StreamingTargetRadius = 256
    end
end

-- ===== НЕВИДИМОСТЬ =====
local function setInvisible(state)
    local char = LP.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.Transparency = state and 1 or 0 end
        if part:IsA("Decal") then part.Transparency = state and 1 or 0 end
    end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Highlight") then v.Enabled = not state end
        if v:IsA("BillboardGui") then v.Enabled = not state end
    end
    if state then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Accessory") then v:Destroy() end
        end
    end
end

