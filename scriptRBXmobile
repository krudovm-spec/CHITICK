                    timerText.TextColor3 = Color3.fromRGB(255, 70, 70)
                elseif remain < 7200 then
                    timerText.TextColor3 = Color3.fromRGB(255, 170, 70)
                else
                    timerText.TextColor3 = Color3.fromRGB(255, 180, 180)
                end
            end
        else
            timerFrame.Visible = false
        end
        task.wait(1)
    end
end)

