local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")
local LP = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local DefaultSpeed = 50
local MinSpeed = 16
local MaxSpeed = 500
local StepSize = 5
local SafeSpeed = 60 -- Максимальная безопасная скорость

-- ===== ПЕРЕМЕННЫЕ =====
local SpeedHackEnabled = false
local CurrentSpeed = DefaultSpeed
local originalWalkSpeed = 16
local originalJumpPower = 50
local lastNotification = 0 -- Чтобы не спамить уведомлениями

-- ===== ФУНКЦИЯ УВЕДОМЛЕНИЯ =====
local function notify(title, text, duration)
    local now = tick()
    if now - lastNotification < 2 then return end -- Антиспам: не чаще 1 раза в 2 сек
    lastNotification = now
    
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 3
        })
    end)
end

-- ===== ФУНКЦИЯ УСТАНОВКИ СКОРОСТИ =====
local function setSpeed(speed)
    local newSpeed = math.clamp(speed, MinSpeed, MaxSpeed)
    
    -- Предупреждение при опасной скорости
    if newSpeed > SafeSpeed and CurrentSpeed <= SafeSpeed then
        notify(
            "ВНИМАНИЕ!",
            "Скорость выше 60! Античит может забанить. Рекомендуем 50-60",
            5
        )
    elseif newSpeed > 100 and CurrentSpeed <= 100 then
        notify(
            "ОПАСНОСТЬ!",
            "Скорость " .. newSpeed .. "! Очень высокий риск бана!",
            5
        )
    end
    
    -- Уведомление о смене скорости
    if newSpeed ~= CurrentSpeed and SpeedHackEnabled then
        local msg
        if newSpeed <= SafeSpeed then
            msg = "Скорость: " .. newSpeed .. " (безопасно)"
        else
            msg = "Скорость: " .. newSpeed .. " (рискованно!)"
        end
        notify("Скорость изменена", msg, 2)
    end
    
    CurrentSpeed = newSpeed
    
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = SpeedHackEnabled and CurrentSpeed or originalWalkSpeed
            hum.JumpPower = SpeedHackEnabled and (CurrentSpeed / 2) or originalJumpPower
        end
    end
end

