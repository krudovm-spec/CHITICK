--[[
    MOBILE-FRIENDLY SCRIPT FOR XENO (FIXED)
]]

local Services = {
    Players = game:GetService("Players"),
    UserInputService = game:GetService("UserInputService"),
    RunService = game:GetService("RunService"),
    TweenService = game:GetService("TweenService"),
    Stats = game:GetService("Stats"),
    CoreGui = game:GetService("CoreGui")
}

local LP = Services.Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- НАСТРОЙКИ
local CORRECT_KEY = "FREE_SLAKINKOD"
local KEY_LINK = "https://t.me/HDVCHIKpublic/27"

local Settings = {
    ESP = true,
    AIMBOT = true,
    KILL_AURA = true,
    BIG_HEADS = true,
    DEATH_MARKERS = true
}

local AimRadius = 150
local KillAuraRange = 20
local HeadSize = 8

-- Флаг авторизации
local isAuthenticated = false

-- ========================================
-- GUI
-- ========================================
local screenGui = Instance.new("ScreenGui", Services.CoreGui)
screenGui.IgnoreGuiInset = true
screenGui.ResetOnSpawn = false
screenGui.Name = "LockScreen"

local blur = Instance.new("BlurEffect", game:GetService("Lighting"))
blur.Size = 15

local mainFrame = Instance.new("Frame", screenGui)
mainFrame.Size = UDim2.new(1, 0, 1, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
mainFrame.BorderSizePixel = 0

local loginBox = Instance.new("Frame", mainFrame)
loginBox.AnchorPoint = Vector2.new(0.5, 0.5)
loginBox.Position = UDim2.new(0.5, 0, 0.4, 0)
loginBox.Size = UDim2.new(0.85, 0, 0, 190)
loginBox.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
loginBox.BorderSizePixel = 0
Instance.new("UICorner", loginBox).CornerRadius = UDim.new(0, 12)

-- Заголовок (без HTML тегов!)
local title = Instance.new("TextLabel", loginBox)
title.Size = UDim2.new(1, -20, 0, 30)
title.Position = UDim2.new(0, 10, 0, 10)
title.Text = "ENTER KEY"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.BackgroundTransparency = 1
title.TextXAlignment = Enum.TextXAlignment.Left

local keyInput = Instance.new("TextBox", loginBox)
keyInput.Size = UDim2.new(1, -20, 0, 40)
keyInput.Position = UDim2.new(0, 10, 0, 45)
keyInput.PlaceholderText = "Key..."
keyInput.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
keyInput.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
keyInput.TextColor3 = Color3.new(1, 1, 1)
keyInput.Font = Enum.Font.GothamMedium
keyInput.TextSize = 14
keyInput.ClearTextOnFocus = false
Instance.new("UICorner", keyInput).CornerRadius = UDim.new(0, 8)

-- Кнопка АКТИВАЦИИ (чистый текст)
local activateBtn = Instance.new("TextButton", loginBox)
activateBtn.Size = UDim2.new(1, -20, 0, 40)
activateBtn.Position = UDim2.new(0, 10, 0, 95)
activateBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
activateBtn.Text = "ACTIVATE"
activateBtn.TextColor3 = Color3.new(1, 1, 1)
activateBtn.Font = Enum.Font.GothamBold
activateBtn.TextSize = 14
Instance.new("UICorner", activateBtn).CornerRadius = UDim.new(0, 8)

local getKeyBtn = Instance.new("TextButton", loginBox)
getKeyBtn.Size = UDim2.new(1, -20, 0, 30)
getKeyBtn.Position = UDim2.new(0, 10, 0, 145)
getKeyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
getKeyBtn.Text = "GET KEY"
getKeyBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
getKeyBtn.Font = Enum.Font.GothamMedium
getKeyBtn.TextSize = 12
Instance.new("UICorner", getKeyBtn).CornerRadius = UDim.new(0, 8)

local attempts = 0

getKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then 
        setclipboard(KEY_LINK)
        getKeyBtn.Text = "COPIED!"
        getKeyBtn.TextColor3 = Color3.new(0.3, 1, 0.3)
        task.wait(1.5)
        getKeyBtn.Text = "GET KEY"
        getKeyBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end)

-- ИСПРАВЛЕНО: чистая логика активации
activateBtn.MouseButton1Click:Connect(function()
    local inputText = keyInput.Text
    -- Убираем пробелы по краям на всякий случай
    inputText = inputText:gsub("^%s+", ""):gsub("%s+$", "")
    
    if inputText == CORRECT_KEY then
        -- Успех
        isAuthenticated = true
        activateBtn.Text = "SUCCESS"
        activateBtn.BackgroundColor3 = Color3.new(0, 0.8, 0)
        
        -- Сразу разблокируем движение
        pcall(function()
            local char = LP.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = 16 end
            end
        end)
        
        task.wait(0.8)
        
        -- Удаляем GUI
        local fadeOut = Services.TweenService:Create(mainFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1})
        fadeOut:Play()
        Services.TweenService:Create(blur, TweenInfo.new(0.5), {Size = 0}):Play()
        
        fadeOut.Completed:Connect(function()
            blur:Destroy()
            screenGui:Destroy()
            StartScript()
        end)
    else
        attempts += 1
        if attempts >= 3 then
            LP:Kick("Wrong key 3 times. Access blocked!")
            return
        end
        activateBtn.Text = "WRONG ("..attempts.."/3)"
        activateBtn.BackgroundColor3 = Color3.new(0.8, 0, 0)
        
        task.wait(2)
        activateBtn.Text = "ACTIVATE"
        activateBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
    end
end)

-- ИСПРАВЛЕНО: блокировка только если НЕ авторизован
Services.RunService.Stepped:Connect(function()
    if isAuthenticated then return end -- Пропускаем если уже авторизован
    
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 0 end
    end
end)

-- ========================================
-- ОСНОВНЫЕ ФУНКЦИИ
-- ========================================
function StartScript()
    -- Разблокируем движение окончательно
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    hum.WalkSpeed = 16
    hum.JumpPower = 50
    
    -- ESP
    if Settings.ESP then
        local function addESP(player)
            if player == LP then return end
            local function onChar(char)
                local hl = Instance.new("Highlight", char)
                hl.FillColor = Color3.new(1, 0, 0)
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.OutlineTransparency = 0
            end
            if player.Character then onChar(player.Character) end
            player.CharacterAdded:Connect(onChar)
        end
        
        for _, p in ipairs(Services.Players:GetPlayers()) do addESP(p) end
        Services.Players.PlayerAdded:Connect(addESP)
    end
    
    -- Пинг
    local pingGui = Instance.new("ScreenGui", Services.CoreGui)
    local pingLabel = Instance.new("TextLabel", pingGui)
    pingLabel.Size = UDim2.new(0, 90, 0, 22)
    pingLabel.Position = UDim2.new(1, -95, 0, 8)
    pingLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    pingLabel.BackgroundTransparency = 0.4
    pingLabel.TextColor3 = Color3.new(1, 1, 1)
    pingLabel.TextSize = 12
    pingLabel.Font = Enum.Font.GothamBold
    pingLabel.BorderSizePixel = 0
    Instance.new("UICorner", pingLabel).CornerRadius = UDim.new(0, 6)
    
    Services.RunService.RenderStepped:Connect(function()
        local ping = math.floor(Services.Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        pingLabel.Text = "Ping " .. ping .. "ms"
        if ping < 80 then pingLabel.TextColor3 = Color3.new(0.3, 1, 0.3)
        elseif ping < 150 then pingLabel.TextColor3 = Color3.new(1, 0.8, 0)
        else pingLabel.TextColor3 = Color3.new(1, 0.3, 0.3) end
    end)
    
    -- Аимбот (кнопка для пальца)
    if Settings.AIMBOT then
        local isAiming = false
        
        local aimButton = Instance.new("TextButton", screenGui)
        aimButton.Size = UDim2.new(0, 50, 0, 50)
        aimButton.Position = UDim2.new(0.85, -25, 0.75, -25)
        aimButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        aimButton.BackgroundTransparency = 0.85
        aimButton.Text = "AIM"
        aimButton.TextSize = 14
        aimButton.BorderSizePixel = 0
        aimButton.Active = true
        Instance.new("UICorner", aimButton).CornerRadius = UDim.new(1, 0)
        
        local fovCircle = Drawing.new("Circle")
        fovCircle.Radius = AimRadius
        fovCircle.Thickness = 1
        fovCircle.Color = Color3.new(1, 1, 1)
        fovCircle.Transparency = 0.7
        fovCircle.Filled = false
        fovCircle.Visible = false
        
        local function getClosest()
            local target = nil
            local minDist = AimRadius
            local center = Services.UserInputService:GetMouseLocation()
            
            for _, p in ipairs(Services.Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        local pos, vis = Camera:WorldToViewportPoint(head.Position)
                        if vis then
                            local dist = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                            if dist < minDist then
                                minDist = dist
                                target = p
                            end
                        end
                    end
                end
            end
            return target
        end
        
        aimButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                isAiming = true
                fovCircle.Visible = true
            end
        end)
        
        aimButton.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                isAiming = false
                fovCircle.Visible = false
            end
        end)
        
        Services.RunService.RenderStepped:Connect(function()
            local pos = Services.UserInputService:GetMouseLocation()
            fovCircle.Position = pos
            
            if isAiming then
                local t = getClosest()
                if t and t.Character and t.Character:FindFirstChild("Head") then
                    Camera.CFrame = Camera.CFrame:Lerp(
                        CFrame.new(Camera.CFrame.Position, t.Character.Head.Position), 
                        0.2
                    )
                end
            end
        end)
    end
    
    -- Kill Aura
    if Settings.KILL_AURA then
        Services.RunService.Stepped:Connect(function()
            local char = LP.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end
            
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            
            for _, p in ipairs(Services.Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot and (root.Position - tRoot.Position).Magnitude <= KillAuraRange then
                        tool:Activate()
                        if tool:FindFirstChild("Handle") then
                            firetouchinterest(tRoot, tool.Handle, 0)
                            firetouchinterest(tRoot, tool.Handle, 1)
                        end
                    end
                end
            end
        end)
    end
    
    -- Big Heads
    if Settings.BIG_HEADS then
        Services.RunService.RenderStepped:Connect(function()
            for _, p in ipairs(Services.Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        head.Size = Vector3.new(HeadSize, HeadSize, HeadSize)
                        head.Transparency = 0.3
                        head.CanCollide = false
                    end
                end
            end
        end)
    end
    
    -- Death Markers
    if Settings.DEATH_MARKERS then
        local function addDeathMarker(character)
            local root = character:WaitForChild("HumanoidRootPart", 5)
            if not root then return end
            
            local hum = character:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            
            hum.Died:Connect(function()
                local marker = Instance.new("Part")
                marker.Name = "DeathMarker"
                marker.Size = Vector3.new(2, 2, 2)
                marker.Position = root.Position + Vector3.new(0, 1, 0)
                marker.Anchored = true
                marker.CanCollide = false
                marker.Color = Color3.new(1, 1, 1)
                marker.Material = Enum.Material.Neon
                marker.Transparency = 0.4
                marker.Parent = workspace
                
                local hl = Instance.new("Highlight", marker)
                hl.FillColor = Color3.new(1, 1, 1)
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                
                task.delay(10, function() marker:Destroy() end)
            end)
        end
        
        Services.Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(addDeathMarker)
        end)
    end
end
