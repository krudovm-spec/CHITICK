local ACTIVATION_CODE = "FREE_SLAKINKODUPDATE"
local ACTIVATION_HOURS = 12
local SAVE_FILE = "HenoCheat_Time.json"

local Activated = false
local ExpiryTime = 0
local RemainingSeconds = 0

-- Загрузка сохранения
local function LoadTime()
    local ok, data = pcall(function()
        return readfile(SAVE_FILE)
    end)
    
    if ok and data then
        local tbl = HttpService:JSONDecode(data)
        if tbl.expiry and os.time() < tbl.expiry then
            Activated = true
            ExpiryTime = tbl.expiry
            RemainingSeconds = tbl.expiry - os.time()
            return true
        end
    end
    return false
end

-- Сохранение
local function SaveTime()
    local data = {expiry = ExpiryTime}
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

-- Активация
local function DoActivate()
    ExpiryTime = os.time() + (ACTIVATION_HOURS * 3600)
    Activated = true
    RemainingSeconds = ACTIVATION_HOURS * 3600
    SaveTime()
end

-- Формат времени
local function FormatTime(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = math.floor(sec % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

