-- Аимбот
RunService.RenderStepped:Connect(function()
    if not activated or not aimbot then return end
    if not UserInputService:IsKeyDown(aimKey) then return end
    
    local best, bestD = nil, 99999
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local c = p.Character
            if c then
                local h = c:FindFirstChild("Head")
                local hm = c:FindFirstChild("Humanoid")
                if h and hm and hm.Health > 0 then
                    local sp, onScr = Camera:WorldToViewportPoint(h.Position)
                    if onScr then
                        local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                        if d < bestD then bestD = d; best = h end
                    end
                end
            end
        end
    end
    if best then Camera.CFrame = CFrame.new(Camera.CFrame.Position, best.Position) end
end)

-- Триггербот
UserInputService.InputBegan:Connect(function(i)
    if not activated or not trigger then return end
    if i.UserInputType == Enum.UserInputType.MouseButton2 then
        local m = LocalPlayer:GetMouse()
        if m.Target and m.Target.Parent then
            local hm = m.Target.Parent:FindFirstChild("Humanoid")
            if hm and hm.Health > 0 then
                mouse1press()
                task.wait(0.04)
                mouse1release()
            end
        end
    end
end)

-- ESP
local function newESP()
    return {
        box = Drawing.new("Square"),
        line = Drawing.new("Line"),
        name = Drawing.new("Text"),
        dist = Drawing.new("Text")
    }
end

RunService.Heartbeat:Connect(function()
    if not activated or not esp then
        for _, e in pairs(espList) do
            for _, d in pairs(e) do
                pcall(function() d.Visible = false end)
            end
        endreturn
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = p.Character
        if not c or not c:FindFirstChild("Head") then
            if espList[p] then
                for _, d in pairs(espList[p]) do pcall(function() d:Remove() end) end
                espList[p] = nil
            end
            continue
        end
        
        local hm = c:FindFirstChild("Humanoid")
        if hm and hm.Health <= 0 then continue end
        
        if not espList[p] then
            local e = newESP()
            e.box.Color = Color3.fromRGB(200, 40, 40)
            e.box.Thickness = 1.5
            e.box.Filled = false
            e.line.Color = Color3.fromRGB(200, 40, 40)
            e.line.Thickness = 1
            e.name.Color = Color3.fromRGB(255, 255, 255)
            e.name.Size = 13
            e.name.Center = true
            e.dist.Color = Color3.fromRGB(180, 180, 180)
            e.dist.Size = 11
            e.dist.Center = true
            espList[p] = e
        end
        
        local e = espList[p]
        local head = c.Head
        local root = c:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        
        local hp, hs = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.4, 0))
        local rp = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        
        if not hs then
            for _, d in pairs(e) do pcall(function() d.Visible = false end) end
            continue
        end
        
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        local bh = 2000 / dist
        local bw = bh * 0.65
        local top = Vector2.new(hp.X - bw/2, hp.Y - bh/2)
        
        pcall(function() e.box.Visible = true; e.box.Position = top; e.box.Size = Vector2.new(bw, bh) end)
        pcall(function() e.line.Visible = true; e.line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); e.line.To = Vector2.new(rp.X, rp.Y) end)
        pcall(function() e.name.Visible = true; e.name.Position = Vector2.new(hp.X, top.Y - 16); e.name.Text = p.Name end)
        pcall(function() e.dist.Visible = true; e.dist.Position = Vector2.new(hp.X, top.Y + bh + 3); e.dist.Text = math.floor(dist) .. "m" end)
    end
end)

