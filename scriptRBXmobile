-- Аимбот
RunService.RenderStepped:Connect(function()
    if not Activated then return end
    if not aimbotOn then return end
    if not UserInputService:IsKeyDown(aimKey) then return end
    
    local best = nil
    local bestDist = 99999
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local c = plr.Character
        if c then
            local head = c:FindFirstChild("Head")
            local hum = c:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local sp, onScr = Camera:WorldToViewportPoint(head.Position)
                if onScr then
                    local mid = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                    local d = (Vector2.new(sp.X, sp.Y) - mid).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = head
                    end
                end
            end
        end
    end
    
    if best then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, best.Position)
    end
end)

