activateBtn.Font = Enum.Font.GothamBold
activateBtn.TextSize = 14
Instance.new("UICorner", activateBtn).CornerRadius = UDim.new(0, 8)

-- Кнопка получить ключ (компактная)
local getKeyBtn = Instance.new("TextButton", loginBox)
getKeyBtn.Size = UDim2.new(1, -20, 0, 30)
getKeyBtn.Position = UDim2.new(0, 10, 0, 142)
getKeyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
getKeyBtn.Text = "🔑 GET KEY"
getKeyBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
getKeyBtn.Font = Enum.Font.GothamMedium
getKeyBtn.TextSize = 12
Instance.new("UICorner", getKeyBtn).CornerRadius = UDim.new(0, 8)

-- Счетчик попыток (компактный)
local attempts = 0
local statusLabel = Instance.new("TextLabel", loginBox)
statusLabel.Size = UDim2.new(1, -20, 0, 0) -- Скрыт по умолчанию
statusLabel.Position = UDim2.new(0, 10, 0, 150)
statusLabel.Text = ""
statusLabel.TextColor3 = Color3.new(1, 0.3, 0.3)
statusLabel.Font = Enum.Font.GothamMedium
statusLabel.TextSize = 11
statusLabel.BackgroundTransparency = 1

-- Логика
getKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then 
        setclipboard(KEY_LINK) 
        getKeyBtn.Text = "✅ COPIED!"
        getKeyBtn.TextColor3 = Color3.new(0.3, 1, 0.3)
        task.wait(1.5)
        getKeyBtn.Text = "🔑 GET KEY"
        getKeyBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end)

activateBtn.MouseButton1Click:Connect(function()
    if keyInput.Text == CORRECT_KEY then
        -- Успех
        activateBtn.Text = "✅ SUCCESS"
        activateBtn.BackgroundColor3 = Color3.new(0, 0.8, 0)
        
        task.wait(0.5)
        
        -- Плавное скрытие
        Services.TweenService:Create(blur, TweenInfo.new(0.8), {Size = 0}):Play()
        local fadeOut = Services.TweenService:Create(mainFrame, TweenInfo.new(0.8), {BackgroundTransparency = 1})
        fadeOut:Play()
        
        fadeOut.Completed:Connect(function()
            blur:Destroy()
            screenGui:Destroy()
            StartScript()
        end)
    else
        attempts += 1
        if attempts >= 3 then
            LP:Kick("❌ Неверный ключ! Доступ заблокирован.")
        end
        activateBtn.Text = "❌ WRONG ("..attempts.."/3)"
        activateBtn.BackgroundColor3 = Color3.new(0.8, 0, 0)
        
        task.wait(1.5)
        activateBtn.Text = "<b>ACTIVATE</b>"
        activateBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
    end
end)

-- ========================================
-- БЛОКИРОВКА ДВИЖЕНИЯ ДО АВТОРИЗАЦИИ
-- ========================================
Services.RunService.Stepped:Connect(function()
    local char = LP.Character
    if char and not screenGui:FindFirstChild("Authenticated") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 0 end
    end
end)

-- ========================================
-- ОСНОВНЫЕ ФУНКЦИИ
-- ========================================
function StartScript()
    screenGui.Name = "Authenticated" -- Маркер авторизации
    
    local char = LP.Character or LP.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    hum.WalkSpeed = 16
    hum.JumpPower = 50
    
    -- ====== ESP (простая подсветка) ======
    if Settings.ESP then
        local function addESP(player)
            if player == LP then return end
            local function onChar(char)
                local hl = Instance.new("Highlight", char)
                hl.FillColor = Color3.new(1, 0, 0)
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.OutlineTransparency = 0
            end
            if player.Character then onChar(player.Character) end
            player.CharacterAdded:Connect(onChar)
        end
        
        for _, p in ipairs(Services.Players:GetPlayers()) do addESP(p) end
        Services.Players.PlayerAdded:Connect(addESP)
    end
    
    -- ====== ПИНГ ИНДИКАТОР (компактный) ======
    local pingGui = Instance.new("ScreenGui", Services.CoreGui)
    local pingLabel = Instance.new("TextLabel", pingGui)
    pingLabel.Size = UDim2.new(0, 90, 0, 22)
    pingLabel.Position = UDim2.new(1, -95, 0, 8)
    pingLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    pingLabel.BackgroundTransparency = 0.4
    pingLabel.TextColor3 = Color3.new(1, 1, 1)
    pingLabel.TextSize = 12
    pingLabel.Font = Enum.Font.GothamBold
    pingLabel.BorderSizePixel = 0
    Instance.new("UICorner", pingLabel).CornerRadius = UDim.new(0, 6)
    
    Services.RunService.RenderStepped:Connect(function()
        local ping = math.floor(Services.Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        pingLabel.Text = "📡 " .. ping .. "ms"
        if ping < 80 then pingLabel.TextColor3 = Color3.new(0.3, 1, 0.3)
        elseif ping < 150 then pingLabel.TextColor3 = Color3.new(1, 0.8, 0)
        else pingLabel.TextColor3 = Color3.new(1, 0.3, 0.3) end
    end)
    
    -- ====== АИМБОТ (по удержанию экрана) ======
    if Settings.AIMBOT then
        local isAiming = false
        
        -- Создаем кнопку для аима на телефоне
        local aimButton = Instance.new("TextButton", Services.CoreGui:WaitForChild("Authenticated") or screenGui)
        aimButton.Size = UDim2.new(0, 50, 0, 50)
        aimButton.Position = UDim2.new(0.85, -25, 0.75, -25)
        aimButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        aimButton.BackgroundTransparency = 0.85
        aimButton.Text = "🎯"
        aimButton.TextSize = 20
        aimButton.BorderSizePixel = 0
        aimButton.Active = true
        Instance.new("UICorner", aimButton).CornerRadius = UDim.new(1, 0)
        
        -- FOV круг
        local fovCircle = Drawing.new("Circle")
        fovCircle.Radius = AimRadius
        fovCircle.Thickness = 1
        fovCircle.Color = Color3.new(1, 1, 1)
        fovCircle.Transparency = 0.7
        fovCircle.Filled = false
        fovCircle.Visible = false
        
        local function getClosest()
            local target = nil
            local minDist = AimRadius
            local center = Services.UserInputService:GetMouseLocation()
            
            for _, p in ipairs(Services.Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        local pos, vis = Camera:WorldToViewportPoint(head.Position)
                        if vis then
                            local dist = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                            if dist < minDist then
                                minDist = dist
                                target = p
                            end
                        end
                    end
                end
            end
            return target
        end
        
        aimButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                isAiming = true
                fovCircle.Visible = true
            end
        end)
        
        aimButton.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                isAiming = false
                fovCircle.Visible = false
            end
        end)
        
        Services.RunService.RenderStepped:Connect(function()
            local pos = Services.UserInputService:GetMouseLocation()
            fovCircle.Position = pos
            
            if isAiming then
                local t = getClosest()
                if t and t.Character and t.Character:FindFirstChild("Head") then
                    Camera.CFrame = Camera.CFrame:Lerp(
                        CFrame.new(Camera.CFrame.Position, t.Character.Head.Position), 
                        0.2
                    )
                end
            end
        end)
    end
    
    -- ====== KILL AURA ======
    if Settings.KILL_AURA then
        Services.RunService.Stepped:Connect(function()
            local char = LP.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end
            
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            
            for _, p in ipairs(Services.Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot and (root.Position - tRoot.Position).Magnitude <= KillAuraRange then
                        tool:Activate()
                        if tool:FindFirstChild("Handle") then
                            firetouchinterest(tRoot, tool.Handle, 0)
                            firetouchinterest(tRoot, tool.Handle, 1)
                        end
                    end
                end
            end
        end)
    end
    
    -- ====== БОЛЬШИЕ ГОЛОВЫ ======
    if Settings.BIG_HEADS then
        Services.RunService.RenderStepped:Connect(function()
            for _, p in ipairs(Services.Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        head.Size = Vector3.new(HeadSize, HeadSize, HeadSize)
                        head.Transparency = 0.3
                        head.CanCollide = false
                    end
                end
            end
        end)
    end
    
    -- ====== МЕТКИ СМЕРТИ ======
    if Settings.DEATH_MARKERS then
        local function addDeathMarker(character)
            local root = character:WaitForChild("HumanoidRootPart", 5)
            if not root then return end
            
            local hum = character:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            
            hum.Died:Connect(function()
                local marker = Instance.new("Part")
                marker.Name = "DeathMarker"
                marker.Size = Vector3.new(2, 2, 2)
                marker.Position = root.Position + Vector3.new(0, 1, 0)
                marker.Anchored = true
                marker.CanCollide = false
                marker.Color = Color3.new(1, 1, 1)
                marker.Material = Enum.Material.Neon
                marker.Transparency = 0.4
                marker.Parent = workspace
                
                local hl = Instance.new("Highlight", marker)
                hl.FillColor = Color3.new(1, 1, 1)
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                
                task.delay(10, function() marker:Destroy() end)
            end)
        end
        
        Services.Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(addDeathMarker)
        end)
    end
end
