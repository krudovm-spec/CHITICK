    local function UpdateESP()
        if not espEnabled then
            for _, esp in pairs(espObjects) do
                for _, drawing in pairs(esp) do
                    if drawing and drawing.Remove then
                        drawing.Visible = false
                    end
                end
            end
            return
        end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            
            local char = player.Character
            if not char or not char:FindFirstChild("Head") or not char:FindFirstChild("Humanoid") then
                if espObjects[player] then
                    for _, drawing in pairs(espObjects[player]) do
                        if drawing and drawing.Remove then
                            drawing:Remove()
                        end
                    end
                    espObjects[player] = nil
                end
                continue
            end
            
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid.Health <= 0 then
                if espObjects[player] then
                    for _, drawing in pairs(espObjects[player]) do
                        if drawing and drawing.Remove then
                            drawing.Visible = false
                        end
                    end
                end
                continue
            end
            
            if not espObjects[player] then
                espObjects[player] = CreateESP(player)
            end
            
            local esp = espObjects[player]
            local head = char.Head
            local root = char:FindFirstChild("HumanoidRootPart")
            
            if not head or not root then continue end
            
            local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local rootPos, rootOnScreen = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
            
            if not headOnScreen and not rootOnScreen then
                for _, drawing in pairs(esp) do
                    if drawing and drawing.Remove then
                        drawing.Visible = false
                    end
                end
                continue
            end
            
            -- Расчёт размера бокса
            local distance = (Camera.CFrame.Position - root.Position).Magnitude
            local boxHeight = 2000 / distance
            local boxWidth = boxHeight * 0.65
            
            local boxTop = Vector2.new(headPos.X - boxWidth/2, headPos.Y - boxHeight/2)
            local boxBottom = Vector2.new(headPos.X + boxWidth/2, headPos.Y + boxHeight/2)
            
            -- Бокс
            if esp.Box then
                esp.Box.Visible = headOnScreen
                esp.Box.Position = boxTop
                esp.Box.Size = Vector2.new(boxWidth, boxHeight)
                esp.Box.Color = theme.Primary
            end
            
            -- Трассер
            if esp.Tracer then
                esp.Tracer.Visible = true
                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                esp.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                
                -- Цвет трассера по ХП
                local healthPercent = humanoid.Health / humanoid.MaxHealth
                esp.Tracer.Color = Color3.fromRGB(
                    255 * (1 - healthPercent),
                    255 * healthPercent,
                    0
                )
            end
            
            -- ХП бар
            if esp.HealthBar and esp.HealthBg then
                local barX = boxTop.X - 6
                local barTop = boxTop.Ylocal barBottom = boxBottom.Y
                local healthPercent = humanoid.Health / humanoid.MaxHealth
                local healthY = barTop + (barBottom - barTop) * (1 - healthPercent)
                
                esp.HealthBg.Visible = headOnScreen
                esp.HealthBg.From = Vector2.new(barX, barTop)
                esp.HealthBg.To = Vector2.new(barX, barBottom)
                
                esp.HealthBar.Visible = headOnScreen
                esp.HealthBar.From = Vector2.new(barX, healthY)
                esp.HealthBar.To = Vector2.new(barX, barBottom)
                esp.HealthBar.Color = Color3.fromRGB(
                    255 * (1 - healthPercent),
                    255 * healthPercent,
                    0
                )
            end
            
            -- Имя
            if esp.NameTag then
                esp.NameTag.Visible = headOnScreen
                esp.NameTag.Position = Vector2.new(headPos.X, boxTop.Y - 18)
                esp.NameTag.Text = player.Name
                esp.NameTag.Color = theme.Text
            end
            
            -- Дистанция
            if esp.Distance then
                esp.Distance.Visible = headOnScreen
                esp.Distance.Position = Vector2.new(headPos.X, boxBottom.Y + 4)
                esp.Distance.Text = math.floor(distance) .. "m"
            end
        end
    end
    
