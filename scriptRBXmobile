local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ===== СОСТОЯНИЯ =====
local FlyEnabled = false
local NoclipEnabled = false
local FlySpeed = 50

local FlyKeys = {
    Forward = false,
    Backward = false,
    Left = false,
    Right = false,
    Up = false,
    Down = false
}

-- ===== NOCLIP =====
local function setNoclip(state)
    local char = LP.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

LP.CharacterAdded:Connect(function()
    if NoclipEnabled then
        task.wait(0.1)
        setNoclip(true)
    end
end)

-- ===== FLY (ИСПРАВЛЕН - висит в воздухе) =====
local function flyLoop()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    -- ОТКЛЮЧАЕМ ГРАВИТАЦИЮ
    hum.PlatformStand = true
    root.Velocity = Vector3.zero -- Сбрасываем скорость по умолчанию (НЕ ПАДАЕТ)
    
    local direction = Vector3.zero
    local camCF = Camera.CFrame
    
    if FlyKeys.Forward then direction += camCF.LookVector end
    if FlyKeys.Backward then direction -= camCF.LookVector end
    if FlyKeys.Right then direction += camCF.RightVector end
    if FlyKeys.Left then direction -= camCF.RightVector end
    
    if FlyKeys.Up then direction += Vector3.new(0, 1, 0) end
    if FlyKeys.Down then direction -= Vector3.new(0, 1, 0) end
    
    if direction.Magnitude > 0 then
        root.Velocity = direction.Unit * FlySpeed
    end
    -- Если ничего не нажато — Velocity = 0 (зависает на месте)
end

-- Кнопка ПРОБЕЛ для Fly Up (держит в воздухе)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if FlyEnabled and not gameProcessed then
        if input.KeyCode == Enum.KeyCode.Space then
            FlyKeys.Up = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then
        FlyKeys.Up = false
    end
end)

RunService.RenderStepped:Connect(function()
    if FlyEnabled then flyLoop() end
    if NoclipEnabled then setNoclip(true) end
end)

