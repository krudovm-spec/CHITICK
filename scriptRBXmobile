local function MakeToggle(parent, label, yPos, callback)
    local box = Instance.new("Frame")
    box.Parent = parent
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    box.Size = UDim2.new(0.84, 0, 0, 30)
    box.Position = UDim2.new(0.08, 0, yPos, 0)
    box.BorderSizePixel = 0
    
    local bc2 = Instance.new("UICorner")
    bc2.CornerRadius = UDim.new(0, 4)
    bc2.Parent = box
    
    local txt = Instance.new("TextLabel")
    txt.Parent = box
    txt.BackgroundTransparency = 1
    txt.Size = UDim2.new(0.6, 0, 1, 0)
    txt.Position = UDim2.new(0.05, 0, 0, 0)
    txt.Font = Enum.Font.Gotham
    txt.Text = label
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
    
    local btn = Instance.new("TextButton")
    btn.Parent = box
    btn.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
    btn.Size = UDim2.new(0.28, 0, 0.7, 0)
    btn.Position = UDim2.new(0.68, 0, 0.15, 0)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    
    local bc3 = Instance.new("UICorner")
    bc3.CornerRadius = UDim.new(0, 3)
    bc3.Parent = btn
    
    local on = false
    
    btn.MouseButton1Click:Connect(function()
        on = not on
        if on then
            btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
            btn.Text = "ON"
        else
            btn.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
            btn.Text = "OFF"
        end
        if callback then callback(on) end
    end)
    
    return btn
end-- Функция создания кнопки
local function MakeButton(parent, label, yPos, cb)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.Size = UDim2.new(0.84, 0, 0, 30)
