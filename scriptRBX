local function createDeathMarker(character, player)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local deathPos = root.Position

    -- 1. Визуальная сфера
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(2, 2, 2)
    marker.Position = deathPos
    marker.Anchored = true
    marker.CanCollide = false
    marker.Shape = Enum.PartType.Ball
    marker.Color = Color3.new(1, 1, 1)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.6
    marker.Parent = workspace

    -- Чтобы сферу было видно сквозь стены
    local highlight = Instance.new("Highlight", marker)
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    -- 2. Текст над местом смерти
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 150, 0, 50)
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.ExtentsOffset = Vector3.new(0, 3, 0) -- Высота текста над сферой
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "DIED: " .. player.Name -- Текст "УМЕР: [Ник]"
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.Code
    label.TextSize = 14
    label.Parent = billboard

    -- 3. Удаление через 20 секунд с анимацией
    task.delay(20, function()
        if marker then
            local tween = game:GetService("TweenService"):Create(marker, TweenInfo.new(2), {Transparency = 1, Size = Vector3.new(0,0,0)})
            game:GetService("TweenService"):Create(label, TweenInfo.new(2), {TextTransparency = 1}):Play()
            tween:Play()
            tween.Completed:Connect(function() marker:Destroy() end)
        end
    end)
end

