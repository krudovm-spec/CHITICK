local function createDeathMarker(character)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    -- Запоминаем позицию смерти
    local deathPos = root.Position

    -- Создаем визуальный эффект (Белая сфера)
    local marker = Instance.new("Part")
    marker.Name = "DeathMarker"
    marker.Shape = Enum.PartType.Ball
    marker.Size = Vector3.new(3, 3, 3)
    marker.Position = deathPos
    marker.Anchored = true
    marker.CanCollide = false
    marker.Color = Color3.new(1, 1, 1) -- Белый
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.5
    marker.Parent = workspace

    -- Добавляем обводку, чтобы было видно сквозь стены
    local highlight = Instance.new("Highlight", marker)
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    -- Удаляем метку через 15 секунд (чтобы не засорять карту)
    task.delay(15, function()
        if marker then
            TweenService:Create(marker, TweenInfo.new(1), {Size = Vector3.new(0,0,0), Transparency = 1}):Play()
            task.wait(1)
            marker:Destroy()
        end
    end)
end

