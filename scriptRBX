local function CreateESP(player)
    local function Setup()
        local char = player.Character or player.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid", 10)
        local root = char:WaitForChild("HumanoidRootPart", 10)
        if not root or not hum then return end

        -- 1. Квадрат и Трассер через Drawing API (если Xeno поддерживает) или Highlight
        local highlight = Instance.new("Highlight", char)
        highlight.FillTransparency = 1
        highlight.OutlineColor = Color3.new(1, 0, 0)
        highlight.OutlineTransparency = 0

        -- 2. Маленькое табло (Ник + ХП + Трассер-линия)
        local bill = Instance.new("BillboardGui", char)
        bill.Name = "ESP_Small"
        bill.AlwaysOnTop = true
        bill.Size = UDim2.new(0, 100, 0, 40)
        bill.ExtentsOffset = Vector3.new(0, -3.5, 0) -- Текст внизу под ногами

        local label = Instance.new("TextLabel", bill)
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextStrokeTransparency = 0.5
        label.TextSize = 10 -- Маленький размер
        label.Text = string.format("%s | %d HP", player.Name, math.floor(hum.Health))

        -- Трассер (простая линия через Beam или Attachment для стабильности в Xeno)
        local a0 = Instance.new("Attachment", root)
        local a1 = Instance.new("Attachment", LocalPlayer.Character:WaitForChild("HumanoidRootPart"))
        local beam = Instance.new("Beam", root)
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.Width0 = 0.05
        beam.Width1 = 0.05
        beam.FaceCamera = true
        beam.Color = ColorSequence.new(Color3.new(1, 0, 0))
        beam.Transparency = NumberSequence.new(0.5)

        hum.HealthChanged:Connect(function()
            label.Text = string.format("%s | %d HP", player.Name, math.floor(hum.Health))
        end)
    end
    Setup()
    player.CharacterAdded:Connect(Setup)
end

