local boxCorner = Instance.new("UICorner")
boxCorner.CornerRadius = UDim.new(0, 5)
boxCorner.Parent = textBox

local checkBtn = Instance.new("TextButton")
checkBtn.Size = UDim2.new(0, 135, 0, 35)
checkBtn.Position = UDim2.new(0.5, -140, 0.6, 0)
checkBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 220)
checkBtn.Text = "Verify Key"
checkBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
checkBtn.TextSize = 14
checkBtn.Font = Enum.Font.GothamBold
checkBtn.Parent = activationFrame

local btnCorner1 = Instance.new("UICorner")
btnCorner1.CornerRadius = UDim.new(0, 5)
btnCorner1.Parent = checkBtn

local getBtn = Instance.new("TextButton")
getBtn.Size = UDim2.new(0, 135, 0, 35)
getBtn.Position = UDim2.new(0.5, 5, 0.6, 0)
getBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
getBtn.Text = "Get Key (Link)"
getBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
getBtn.TextSize = 14
getBtn.Font = Enum.Font.GothamBold
getBtn.Parent = activationFrame

local btnCorner2 = Instance.new("UICorner")
btnCorner2.CornerRadius = UDim.new(0, 5)
btnCorner2.Parent = getBtn

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 25)
status.Position = UDim2.new(0, 0, 0.85, 0)
status.BackgroundTransparency = 1
status.Text = "Waiting for input..."
status.TextColor3 = Color3.fromRGB(150, 150, 150)
status.TextSize = 12
status.Font = Enum.Font.Gotham
status.Parent = activationFrame

local loading = true
task.spawn(function()
    while loading do
        for i = 0, 3 do
            if not loading then break end
            loadingText.Text = "XENO | Loading" .. string.rep(".", i)
            task.wait(0.4)
        end
    end
end)

task.wait(2.5)
loading = false
loadingFrame.Visible = false
activationFrame.Visible = true

getBtn.MouseButton1Click:Connect(function()
    if setclipboard or toclipboard then
        local copyFunc = setclipboard or toclipboard
        copyFunc(KEY_LINK)
        status.TextColor3 = Color3.fromRGB(80, 220, 120)
        status.Text = "Link copied to your clipboard!"
    else
        textBox.Text = KEY_LINK
        status.TextColor3 = Color3.fromRGB(220, 180, 80)
        status.Text = "Clipboard error. Link copied to input box."
    end
end)

checkBtn.MouseButton1Click:Connect(function()
    if textBox.Text == CORRECT_KEY then
        status.TextColor3 = Color3.fromRGB(80, 220, 120)
        status.Text = "Key Approved!"
        task.wait(0.5)
        
        local tInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(mainFrame, tInfo, {BackgroundTransparency = 1, Size = UDim2.new(0,0,0,0)})
        
        for _, v in pairs(activationFrame:GetChildren()) do v.Visible = false end
        if uiStroke then uiStroke:Destroy() end
        tween:Play()
        
        tween.Completed:Connect(function()
            screenGui:Destroy()
        end)
    else
        wrong_attempts = wrong_attempts + 1
        textBox.Text = ""
        
        if wrong_attempts >= MAX_ATTEMPTS then
            status.TextColor3 = Color3.fromRGB(255, 0, 0)
            status.Text = "Kicking..."
            task.wait(0.5)
            -- Кик игрока с сервера с указанием причины
            LocalPlayer:Kick("\n[Xeno Security]\nToo many incorrect key attempts.") [3]
        else
            status.TextColor3 = Color3.fromRGB(220, 80, 80)
            status.Text = "Incorrect key! Attempts left: " .. tostring(MAX_ATTEMPTS - wrong_attempts)
        end
    end
end)
